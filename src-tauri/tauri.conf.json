{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskTrace",
  "version": "0.2.1",
  "identifier": "com.desktrace.app",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskTrace",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "visible": true
      }
    ],
    "trayIcon": {
      "id": "desktrace",
      "iconPath": "icons/32x32.png",
      "tooltip": "DeskTrace — Ctrl+Shift+S to capture",
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://127.0.0.1:8741 data:; connect-src 'self' http://127.0.0.1:8741 http://localhost:8741; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
